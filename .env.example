# Template only — committed to git. Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets here.
# In production, set the same keys in Vercel → Project Settings → Environment Variables.

# Google Sheets (lead storage)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PRIVATE KEY exactly as it appears in the service-account JSON,
# including the BEGIN/END lines and the literal \n line breaks.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Comma-separated list of recipients for new-lead notifications
LEAD_NOTIFICATION_EMAIL=

# Admin — Google Sign-In
# Public OAuth Client ID from Google Cloud Console (Web application credentials).
# Embedded into the admin login page, so it's safe to expose.
PUBLIC_GOOGLE_CLIENT_ID=
# Comma-separated allowlist of Google email addresses permitted to sign in
ADMIN_ALLOWED_EMAILS=

# Generate a random 32+ char string for this. You can run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
