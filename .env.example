# Template only — committed to git. Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets here.
# In production, set the same keys in Vercel → Project Settings → Environment Variables.

# Google Sheets (lead storage)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PRIVATE KEY exactly as it appears in the service-account JSON,
# including the BEGIN/END lines and the literal \n line breaks.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# Admin
ADMIN_PASSWORD=
# Generate a random 32+ char string for this. You can run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
