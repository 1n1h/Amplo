---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ScrollMarquee from '../components/ScrollMarquee.astro';
// import LogoMarquee from '../components/LogoMarquee.astro';
import AudienceMarquee from '../components/AudienceMarquee.astro';
import IndustryMarquee from '../components/IndustryMarquee.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main id="main">
    <Hero />
    <ScrollMarquee />
    <About />
    {/* <LogoMarquee /> — hidden until we have permission for client logos */}
    <Services />
    <AudienceMarquee />
    <Reviews />
    <IndustryMarquee />
    <Contact />
  </main>
  <Footer />
</Layout>
