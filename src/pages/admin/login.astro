---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../lib/session';

export const prerender = false;

if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin', 302);
}

const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
---

<AdminLayout title="Admin sign-in — Amplo Consulting">
  <main class="login-shell relative min-h-screen flex items-center justify-center p-6 overflow-hidden">
    <!-- Animated aurora backdrop -->
    <div aria-hidden="true" class="aurora-bg">
      <div class="aurora aurora-1"></div>
      <div class="aurora aurora-2"></div>
      <div class="aurora aurora-3"></div>
      <div class="grid-overlay"></div>
    </div>

    <div class="relative w-full max-w-md">
      <a href="/" class="wordmark-xl block text-center mb-14" aria-label="Amplo Consulting">
        Amplo<span class="dot">.</span>
      </a>

      <div class="glass-card p-10 text-center">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-[var(--color-gold)]">
          Admin Access
        </p>
        <h1 class="mt-3 font-display text-3xl text-[var(--color-cream)]">Sign in</h1>
        <p class="mt-3 text-sm text-[var(--color-text-muted)]">
          Use your authorized Google account.
        </p>

        {clientId ? (
          <>
            <div
              id="g_id_onload"
              data-client_id={clientId}
              data-context="signin"
              data-ux_mode="popup"
              data-callback="amploGoogleSignIn"
              data-auto_select="true"
              data-itp_support="true"
            />
            <div class="google-wrap mt-8">
              <div
                class="g_id_signin"
                data-type="standard"
                data-shape="pill"
                data-theme="filled_black"
                data-text="signin_with"
                data-size="large"
                data-logo_alignment="left"
              />
            </div>
            <script src="https://accounts.google.com/gsi/client" async defer is:inline />
            <p
              id="login-error"
              class="hidden mt-5 text-sm text-[var(--color-gold)]"
              role="alert"
            />
          </>
        ) : (
          <p class="mt-6 text-sm text-[var(--color-gold)]">
            Google sign-in is not configured. Set <code>PUBLIC_GOOGLE_CLIENT_ID</code> in env vars.
          </p>
        )}

        <a href="/" class="back-link mt-10 inline-block">← Back to site</a>
      </div>
    </div>
  </main>

  <style>
    .login-shell {
      background: var(--color-navy);
    }

    /* --- Animated aurora background --- */
    .aurora-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
    }
    .aurora {
      position: absolute;
      border-radius: 9999px;
      filter: blur(110px);
      will-change: transform;
    }
    .aurora-1 {
      top: -15%;
      left: -10%;
      width: 55vmax;
      height: 55vmax;
      background: radial-gradient(
        circle,
        color-mix(in oklab, var(--color-gold) 35%, transparent) 0%,
        transparent 65%
      );
      animation: drift-1 26s ease-in-out infinite alternate;
    }
    .aurora-2 {
      top: 25%;
      right: -20%;
      width: 50vmax;
      height: 50vmax;
      background: radial-gradient(
        circle,
        color-mix(in oklab, var(--color-periwinkle) 40%, transparent) 0%,
        transparent 60%
      );
      animation: drift-2 32s ease-in-out infinite alternate;
    }
    .aurora-3 {
      bottom: -20%;
      left: 15%;
      width: 60vmax;
      height: 60vmax;
      background: radial-gradient(
        circle,
        color-mix(in oklab, var(--color-gold) 22%, transparent) 0%,
        transparent 60%
      );
      animation: drift-3 40s ease-in-out infinite alternate;
    }
    @keyframes drift-1 {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(18vmin, 10vmin) scale(1.18); }
    }
    @keyframes drift-2 {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(-14vmin, 12vmin) scale(0.88); }
    }
    @keyframes drift-3 {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(10vmin, -12vmin) scale(1.1); }
    }
    .grid-overlay {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(237, 229, 210, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(237, 229, 210, 0.03) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    }

    /* --- Big animated wordmark --- */
    .wordmark-xl {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: clamp(3.75rem, 9vw, 6rem);
      line-height: 1;
      letter-spacing: -0.015em;
      color: var(--color-cream);
      text-decoration: none;
      text-shadow:
        0 0 50px color-mix(in oklab, var(--color-gold) 28%, transparent),
        0 4px 24px rgba(0, 0, 0, 0.45);
      animation: wordmark-enter 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .wordmark-xl .dot {
      color: var(--color-gold);
      display: inline-block;
      animation: dot-pulse 3.2s ease-in-out infinite;
      transform-origin: center;
    }
    @keyframes wordmark-enter {
      from { opacity: 0; transform: translateY(24px) scale(0.94); }
      to   { opacity: 1; transform: translateY(0)    scale(1); }
    }
    @keyframes dot-pulse {
      0%, 100% {
        transform: scale(1);
        text-shadow: 0 0 0 transparent;
      }
      50% {
        transform: scale(1.18);
        text-shadow: 0 0 28px color-mix(in oklab, var(--color-gold) 70%, transparent);
      }
    }

    /* --- Glassmorphism card --- */
    .glass-card {
      position: relative;
      background: color-mix(in oklab, var(--color-navy-elevated) 28%, transparent);
      backdrop-filter: blur(24px) saturate(1.4);
      -webkit-backdrop-filter: blur(24px) saturate(1.4);
      border: 1px solid color-mix(in oklab, var(--color-cream) 13%, transparent);
      border-radius: 1.25rem;
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, var(--color-cream) 14%, transparent),
        0 32px 64px -16px rgba(0, 0, 0, 0.55),
        0 0 80px -20px color-mix(in oklab, var(--color-gold) 22%, transparent);
      animation: card-enter 1s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
    }
    @keyframes card-enter {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    /* Subtle gradient hairline that wraps the card */
    .glass-card::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-gold) 55%, transparent) 0%,
        transparent 35%,
        color-mix(in oklab, var(--color-periwinkle) 28%, transparent) 75%,
        color-mix(in oklab, var(--color-gold) 35%, transparent) 100%
      );
      -webkit-mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
              mask-composite: exclude;
      pointer-events: none;
    }

    /* --- Google sign-in wrapper polish --- */
    .google-wrap {
      display: flex;
      justify-content: center;
      filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.35));
      transition: filter 200ms ease, transform 200ms ease;
    }
    .google-wrap:hover {
      filter: drop-shadow(0 14px 28px rgba(201, 169, 97, 0.35));
      transform: translateY(-1px);
    }

    /* --- Back link --- */
    .back-link {
      font-family: var(--font-sans);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      text-decoration: none;
      transition: color 200ms ease, letter-spacing 200ms ease;
    }
    .back-link:hover {
      color: var(--color-gold);
      letter-spacing: 0.24em;
    }

    @media (prefers-reduced-motion: reduce) {
      .aurora,
      .wordmark-xl,
      .wordmark-xl .dot,
      .glass-card {
        animation: none;
      }
    }
  </style>

  <script is:inline>
    function amploGoogleSignIn(response) {
      const errorEl = document.getElementById('login-error');
      const showError = (msg) => {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
      };

      fetch('/api/admin/google-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ credential: response.credential }),
      })
        .then(async (res) => {
          const json = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(json.error || `Sign-in failed (${res.status})`);
          window.location.href = '/admin';
        })
        .catch((err) => {
          showError(err.message || 'Sign-in failed.');
          if (window.google && window.google.accounts && window.google.accounts.id) {
            window.google.accounts.id.cancel();
          }
        });
    }
    window.amploGoogleSignIn = amploGoogleSignIn;
  </script>
</AdminLayout>
