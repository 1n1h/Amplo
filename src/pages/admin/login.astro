---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../lib/session';

export const prerender = false;

if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin', 302);
}

const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
---

<AdminLayout title="Admin sign-in — Amplo Consulting">
  <main class="min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-sm">
      <a href="/" class="wordmark text-xl block text-center mb-10" aria-label="Amplo Consulting">
        Amplo<span class="dot">.</span>
      </a>

      <div class="rounded-md border border-[var(--color-cream)]/10 bg-[var(--color-navy-elevated)] p-8 text-center">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.15em] text-[var(--color-gold)]">
          Admin Access
        </p>
        <h1 class="mt-3 text-2xl">Sign in</h1>
        <p class="mt-3 text-sm text-[var(--color-text-muted)]">
          Use your authorized Google account.
        </p>

        {clientId ? (
          <>
            <div
              id="g_id_onload"
              data-client_id={clientId}
              data-context="signin"
              data-ux_mode="popup"
              data-callback="amploGoogleSignIn"
              data-auto_select="true"
              data-itp_support="true"
            />
            <div class="mt-6 flex justify-center">
              <div
                class="g_id_signin"
                data-type="standard"
                data-shape="rectangular"
                data-theme="filled_black"
                data-text="signin_with"
                data-size="large"
                data-logo_alignment="left"
              />
            </div>
            <script src="https://accounts.google.com/gsi/client" async defer is:inline />
            <p
              id="login-error"
              class="hidden mt-5 text-sm text-[var(--color-gold)]"
              role="alert"
            />
          </>
        ) : (
          <p class="mt-6 text-sm text-[var(--color-gold)]">
            Google sign-in is not configured. Set <code>PUBLIC_GOOGLE_CLIENT_ID</code> in env vars.
          </p>
        )}

        <a
          href="/"
          class="mt-8 block text-center text-xs uppercase tracking-[0.15em] text-[var(--color-text-muted)] hover:text-[var(--color-gold)] transition"
        >
          ← Back to site
        </a>
      </div>
    </div>
  </main>

  <script is:inline>
    function amploGoogleSignIn(response) {
      const errorEl = document.getElementById('login-error');
      const showError = (msg) => {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
      };

      fetch('/api/admin/google-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ credential: response.credential }),
      })
        .then(async (res) => {
          const json = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(json.error || `Sign-in failed (${res.status})`);
          window.location.href = '/admin';
        })
        .catch((err) => {
          showError(err.message || 'Sign-in failed.');
          if (window.google && window.google.accounts && window.google.accounts.id) {
            window.google.accounts.id.cancel();
          }
        });
    }
    window.amploGoogleSignIn = amploGoogleSignIn;
  </script>
</AdminLayout>
