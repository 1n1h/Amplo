---
import Eyebrow from './Eyebrow.astro';
import BookingForm from './BookingForm.astro';
import { InteractiveLight } from './InteractiveLight';
---

<section id="contact" class="relative overflow-hidden py-24 md:py-40">
  <InteractiveLight client:visible shineColor="#c9a961" lampHeight="6vh" lampWidth="6vh" transitionDuration={720} opacity={0.5} />
  <div class="relative container-site max-w-4xl">
    <div class="text-center">
      <div class="fade-up">
        <Eyebrow label="Let's Begin" variant="flanked" align="center" />
      </div>

      <h2
        class="fade-up section-heading mt-8"
        style="transition-delay: 60ms;"
      >
        Tell us what's <em>slowing you down.</em>
      </h2>
    </div>

    <div class="fade-up -mt-4" style="transition-delay: 120ms;">
      <BookingForm />
    </div>
  </div>
</section>
