---
const items = [
  'Compliance Assessments',
  'Governance Advisory',
  'Risk Management',
  'IP Protection',
  'Business Strategy',
];
// Duplicate so the marquee loop is seamless.
const loop = [...items, ...items];
---

<section
  aria-label="Service highlights"
  class="border-y border-[var(--color-gold)]/40 bg-[var(--color-gold)]/95 overflow-hidden"
>
  <div class="marquee py-4">
    <ul class="marquee-track flex items-center gap-12 whitespace-nowrap" aria-hidden="false">
      {
        loop.map((item, i) => (
          <li class="flex items-center gap-12">
            <span class="text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-[var(--color-navy)]">
              {item}
            </span>
            {i < loop.length - 1 && (
              <span
                class="inline-block h-px w-10 bg-[var(--color-navy)]/40"
                aria-hidden="true"
              />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .marquee {
    --duration: 40s;
    position: relative;
  }
  .marquee-track {
    width: max-content;
    animation: marquee-scroll var(--duration) linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
