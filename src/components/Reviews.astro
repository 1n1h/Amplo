---
import Eyebrow from './Eyebrow.astro';
import reviews from '../content/reviews.json';
import { TestimonialStack } from './TestimonialStack';
---

<section id="reviews" class="on-cream relative py-24 md:py-32 overflow-hidden">
  <!-- Soft gold radial glow centered behind the card stack. Adapted from the
       background-components.tsx pattern (radial-gradient + multiply blend),
       retoned to brand gold so it halos the active testimonial card. -->
  <div aria-hidden="true" class="reviews-glow"></div>

  <div class="relative container-site">
    <div class="mx-auto max-w-3xl text-center">
      <div class="fade-up">
        <Eyebrow label="Testimonials" variant="flanked" align="center" />
      </div>

      <h2
        class="fade-up section-heading mt-8"
        style="transition-delay: 60ms;"
      >
        What founders <em>say.</em>
      </h2>
    </div>
  </div>

  <div class="relative fade-up mt-16" style="transition-delay: 120ms;">
    <TestimonialStack client:visible items={reviews} />
  </div>
</section>

<style>
  /* Cream section override: flip foreground / background palette. */
  .on-cream {
    background: var(--color-cream);
    color: var(--color-navy);
  }
  .on-cream h2 {
    color: var(--color-navy);
  }
  .on-cream h2 em {
    color: var(--color-gold);
    font-style: italic;
    font-weight: 500;
  }

  /* Soft gold spotlight behind the testimonial stack. Multiply blend mode
     mixes the gold into the cream base — creates a warm halo without a
     hard color edge. */
  .reviews-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(
      ellipse 70% 60% at 50% 55%,
      var(--color-gold) 0%,
      transparent 70%
    );
    opacity: 0.45;
    mix-blend-mode: multiply;
  }
</style>
