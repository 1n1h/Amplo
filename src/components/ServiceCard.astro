---
interface Props {
  number: string;
  name: string;
  description: string;
}
const { number, name, description } = Astro.props;
---

<article class="service-card group relative bg-[var(--color-navy-elevated)] rounded-md p-7 md:p-9 transition-all duration-300 ease-out">
  <span
    aria-hidden="true"
    class="card-accent absolute left-6 md:left-8 top-0 h-1 w-10 bg-[var(--color-gold)] transition-all duration-300 ease-out"
  ></span>

  <div class="flex items-start justify-between">
    <span class="font-[var(--font-display)] text-4xl md:text-5xl font-medium text-[var(--color-gold)] leading-none">
      {number}
    </span>
    <span class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-[var(--color-gold)]/80">
      Service
    </span>
  </div>

  <h3 class="mt-6 text-2xl md:text-[1.625rem]">{name}</h3>

  <span aria-hidden="true" class="mt-4 block h-px w-10 bg-[var(--color-gold)]/40"></span>

  <p class="mt-5 text-sm md:text-base text-[var(--color-text-muted)] leading-relaxed">
    {description}
  </p>
</article>

<style>
  .service-card {
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-cream) 6%, transparent);
  }
  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-gold) 35%, transparent),
      0 20px 40px -20px color-mix(in oklab, #000 70%, transparent);
  }
  .service-card:hover .card-accent {
    width: 4rem;
  }
</style>
