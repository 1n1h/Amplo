---
interface Props {
  label: string;
  variant?: 'left' | 'flanked';
  align?: 'left' | 'center';
  /** Color treatment. Default is brand gold; 'navy' is used on cream sections. */
  tone?: 'gold' | 'navy';
  class?: string;
}

const {
  label,
  variant = 'left',
  align = 'left',
  tone = 'gold',
  class: className = '',
} = Astro.props;

const lineColor = tone === 'navy' ? 'bg-[var(--color-navy)]' : 'bg-[var(--color-gold)]';
const textColor = tone === 'navy' ? 'text-[var(--color-navy)]' : 'text-[var(--color-gold)]';
---

<div
  class:list={[
    'flex items-center gap-3',
    align === 'center' && 'justify-center',
    className,
  ]}
>
  <span class:list={['inline-block w-10 h-px', lineColor]} aria-hidden="true"></span>
  <span class:list={['text-[0.75rem] font-semibold uppercase tracking-[0.15em]', textColor]}>
    {label}
  </span>
  {variant === 'flanked' && <span class:list={['inline-block w-10 h-px', lineColor]} aria-hidden="true"></span>}
</div>
