---
interface Props {
  label: string;
  variant?: 'left' | 'flanked';
  align?: 'left' | 'center';
  class?: string;
}

const { label, variant = 'left', align = 'left', class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex items-center gap-3',
    align === 'center' && 'justify-center',
    className,
  ]}
>
  <span class="eyebrow-line" aria-hidden="true"></span>
  <span class="text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[var(--color-gold)]">
    {label}
  </span>
  {variant === 'flanked' && <span class="eyebrow-line" aria-hidden="true"></span>}
</div>
