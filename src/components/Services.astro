---
import Eyebrow from './Eyebrow.astro';
import ServiceCard from './ServiceCard.astro';
import services from '../content/services.json';
---

<section id="services" class="relative overflow-hidden py-24 md:py-40">
  <div class="relative container-site">
    <div class="mx-auto max-w-3xl text-center">
      <div class="fade-up">
        <Eyebrow label="What We Do" variant="flanked" align="center" />
      </div>

      <h2
        class="fade-up section-heading mt-8"
        style="transition-delay: 60ms;"
      >
        Quick problems. <em>Faster fixes.</em>
      </h2>
    </div>

    <div class="fade-up mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 120ms;">
      {services.map((s) => <ServiceCard {...s} />)}
    </div>
  </div>
</section>
