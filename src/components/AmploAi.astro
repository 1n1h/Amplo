---
// Amplo AI — floating chat widget in the bottom-right corner.
// Streams from /api/chat (Vercel AI Gateway under the hood).
---

<div id="amplo-ai" aria-live="polite">
  <button
    type="button"
    id="amplo-ai-toggle"
    class="ai-fab"
    aria-label="Open Amplo AI assistant"
    aria-expanded="false"
    aria-controls="amplo-ai-panel"
  >
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
    </svg>
    <span class="ai-fab-label">Amplo AI</span>
  </button>

  <div
    id="amplo-ai-panel"
    class="ai-panel hidden"
    role="dialog"
    aria-label="Amplo AI assistant"
    aria-modal="false"
  >
    <header class="ai-panel-header">
      <div>
        <p class="ai-panel-eyebrow">Amplo AI</p>
        <p class="ai-panel-sub">Ask anything. Book a meeting.</p>
      </div>
      <button type="button" id="amplo-ai-close" class="ai-close" aria-label="Close assistant">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
      </button>
    </header>

    <div id="ai-messages" class="ai-messages">
      <div class="ai-bubble assistant">
        <p>Hi 👋 I'm Amplo AI. How can I help?</p>
      </div>
      <div id="ai-suggestions" class="ai-suggestions">
        <button type="button" class="ai-chip" data-suggestion="Book a 30-minute intro call">Book a meeting</button>
        <button type="button" class="ai-chip" data-suggestion="What services does Amplo offer?">What we offer</button>
      </div>
    </div>

    <form id="ai-form" class="ai-form" autocomplete="off">
      <input
        id="ai-input"
        type="text"
        placeholder="Type a message…"
        maxlength="2000"
        autocomplete="off"
        aria-label="Message"
      />
      <button type="submit" id="ai-send" class="ai-send" aria-label="Send message">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
      </button>
    </form>
    <p class="ai-footnote">AI responses may be imperfect. For anything binding, email <a href="mailto:Roger@amploconsulting.com">Roger@amploconsulting.com</a>.</p>
  </div>
</div>

<style>
  #amplo-ai {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    font-family: var(--font-sans);
  }
  .hidden { display: none !important; }

  /* --- Floating action button --- */
  .ai-fab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--color-gold);
    color: var(--color-navy);
    border: 0;
    border-radius: 9999px;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.45);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: transform 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }
  .ai-fab:hover {
    background: var(--color-gold-hover);
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.55);
  }
  .ai-fab-label { line-height: 1; }

  /* --- Chat panel --- */
  .ai-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.75rem);
    width: min(380px, calc(100vw - 2.5rem));
    height: min(560px, calc(100vh - 6rem));
    /* Light iMessage-style backdrop. Body of the chat sits on this. */
    background: #f2f2f7;
    border: 1px solid color-mix(in oklab, var(--color-cream) 14%, transparent);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.7);
    color: #1c1c1e;
    animation: ai-slide-up 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes ai-slide-up {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ai-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 10%, transparent);
    background: var(--color-navy-elevated);
  }
  .ai-panel-eyebrow {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .ai-panel-sub {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-cream);
    line-height: 1.2;
  }
  .ai-close {
    background: transparent;
    border: 0;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.35rem;
    border-radius: 4px;
    transition: color 150ms ease, background 150ms ease;
  }
  .ai-close:hover { color: var(--color-gold); background: color-mix(in oklab, var(--color-cream) 6%, transparent); }

  /* --- Messages --- */
  .ai-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.18) transparent;
  }
  .ai-messages::-webkit-scrollbar { width: 6px; }
  .ai-messages::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.18);
    border-radius: 3px;
  }

  /* iMessage-style bubbles. Bot left, user right. */
  .ai-bubble {
    max-width: 80%;
    padding: 0.55rem 0.85rem;
    font-size: 0.82rem;
    line-height: 1.45;
    border-radius: 18px;
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  .ai-bubble p { margin: 0; }
  .ai-bubble p + p { margin-top: 0.4rem; }

  .ai-bubble.assistant {
    align-self: flex-start;
    /* Medium grey bubble with white text per spec. */
    background: #7c7c82;
    color: #ffffff;
    /* iMessage-style tail (squared bottom-left corner) */
    border-bottom-left-radius: 4px;
  }
  .ai-bubble.user {
    align-self: flex-end;
    /* iMessage blue. */
    background: #007aff;
    color: #ffffff;
    /* Tail on bottom-right */
    border-bottom-right-radius: 4px;
  }

  .ai-bubble.assistant .ai-cursor {
    display: inline-block;
    width: 7px;
    height: 1.05em;
    background: #ffffff;
    margin-left: 2px;
    vertical-align: -2px;
    animation: ai-blink 1s steps(2) infinite;
  }
  @keyframes ai-blink {
    50% { opacity: 0; }
  }

  /* --- Suggestion chips (on light bg now) --- */
  .ai-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
    align-self: flex-start;
  }
  .ai-chip {
    padding: 0.45rem 0.85rem;
    background: #ffffff;
    border: 1px solid #007aff;
    border-radius: 9999px;
    color: #007aff;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease, transform 150ms ease;
  }
  .ai-chip:hover {
    background: #007aff;
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* --- Form on light bg --- */
  .ai-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.85rem 1rem 0.25rem;
    border-top: 1px solid rgba(60, 60, 67, 0.12);
    background: #f2f2f7;
  }
  #ai-input {
    flex: 1;
    background: #ffffff;
    border: 1px solid rgba(60, 60, 67, 0.18);
    border-radius: 9999px;
    padding: 0.6rem 1rem;
    color: #1c1c1e;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    outline: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  #ai-input::placeholder { color: rgba(60, 60, 67, 0.45); }
  #ai-input:focus {
    border-color: #007aff;
    box-shadow: 0 0 0 2px rgba(0, 122, 255, 0.22);
  }
  .ai-send {
    background: var(--color-gold);
    color: var(--color-navy);
    border: 0;
    padding: 0 0.85rem;
    border-radius: 9999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 150ms ease, transform 150ms ease;
  }
  .ai-send:hover:not(:disabled) { background: var(--color-gold-hover); }
  .ai-send:disabled { opacity: 0.5; cursor: not-allowed; }
  .ai-send svg { transform: rotate(45deg); margin-left: -2px; }

  .ai-footnote {
    margin: 0;
    padding: 0.4rem 1rem 0.85rem;
    font-size: 0.62rem;
    color: rgba(60, 60, 67, 0.6);
    text-align: center;
    background: #f2f2f7;
  }
  .ai-footnote a {
    color: rgba(60, 60, 67, 0.75);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ai-footnote a:hover {
    color: #007aff;
  }
  .ai-footnote a:hover { color: var(--color-gold); }

  @media (max-width: 480px) {
    #amplo-ai { right: 0.75rem; bottom: 0.75rem; }
    .ai-fab-label { display: none; }
    .ai-fab { padding: 0.85rem; }
    .ai-panel { width: calc(100vw - 1.5rem); height: calc(100vh - 5rem); border-radius: 12px; }
  }
</style>

<script>
  interface ChatMessage { role: 'user' | 'assistant'; content: string }

  const toggle = document.getElementById('amplo-ai-toggle') as HTMLButtonElement;
  const closeBtn = document.getElementById('amplo-ai-close') as HTMLButtonElement;
  const panel = document.getElementById('amplo-ai-panel') as HTMLDivElement;
  const messagesEl = document.getElementById('ai-messages') as HTMLDivElement;
  const form = document.getElementById('ai-form') as HTMLFormElement;
  const input = document.getElementById('ai-input') as HTMLInputElement;
  const sendBtn = document.getElementById('ai-send') as HTMLButtonElement;
  const suggestionsEl = document.getElementById('ai-suggestions') as HTMLDivElement;

  const history: ChatMessage[] = [];
  let isStreaming = false;

  function openPanel() {
    panel.classList.remove('hidden');
    toggle.setAttribute('aria-expanded', 'true');
    setTimeout(() => input.focus(), 60);
  }
  function closePanel() {
    panel.classList.add('hidden');
    toggle.setAttribute('aria-expanded', 'false');
  }
  toggle.addEventListener('click', () => {
    panel.classList.contains('hidden') ? openPanel() : closePanel();
  });
  closeBtn.addEventListener('click', closePanel);

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addBubble(role: 'user' | 'assistant', text: string): HTMLDivElement {
    const div = document.createElement('div');
    div.className = `ai-bubble ${role}`;
    const p = document.createElement('p');
    p.textContent = text;
    div.appendChild(p);
    messagesEl.appendChild(div);
    scrollToBottom();
    return div;
  }

  // Hide the suggestion chips once the conversation starts.
  function hideSuggestions() {
    if (suggestionsEl && !suggestionsEl.classList.contains('hidden')) {
      suggestionsEl.classList.add('hidden');
    }
  }

  suggestionsEl?.querySelectorAll<HTMLButtonElement>('button.ai-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-suggestion') || '';
      if (!text || isStreaming) return;
      send(text);
    });
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || isStreaming) return;
    send(text);
  });

  async function send(text: string) {
    hideSuggestions();
    addBubble('user', text);
    history.push({ role: 'user', content: text });
    input.value = '';

    isStreaming = true;
    sendBtn.disabled = true;

    // Create empty assistant bubble + cursor to fill as the stream arrives.
    const bubble = document.createElement('div');
    bubble.className = 'ai-bubble assistant';
    const para = document.createElement('p');
    bubble.appendChild(para);
    const cursor = document.createElement('span');
    cursor.className = 'ai-cursor';
    para.appendChild(cursor);
    messagesEl.appendChild(bubble);
    scrollToBottom();

    let assistantText = '';

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });
      if (!res.ok || !res.body) {
        const errJson = await res.json().catch(() => ({}));
        para.textContent = errJson.error || `Something went wrong (${res.status}).`;
        cursor.remove();
        return;
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        const chunk = decoder.decode(value, { stream: true });
        assistantText += chunk;
        // Replace cursor in place: rebuild the paragraph as text + cursor.
        para.textContent = assistantText;
        para.appendChild(cursor);
        scrollToBottom();
      }
    } catch (err) {
      console.error('[amplo-ai] stream failed', err);
      if (!assistantText) {
        para.textContent = 'Network error. Please try again.';
      }
    } finally {
      cursor.remove();
      if (assistantText) {
        history.push({ role: 'assistant', content: assistantText });
      }
      isStreaming = false;
      sendBtn.disabled = false;
      input.focus();
    }
  }
</script>
