---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Admin — Amplo Consulting' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="theme-color" content="#0B1936" />
  </head>
  <body class="min-h-screen text-[var(--color-cream)]">
    <slot />
  </body>
</html>
